# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore — nunca se commitea.

# --- IA (Fase 4) ---
ANTHROPIC_API_KEY=

# --- Fuentes de datos (Fase 2) ---
DUNE_API_KEY=
MESSARI_API_KEY=
# Demo API: https://www.coingecko.com/en/developers/dashboard
COINGECKO_DEMO_API_KEY=
# DeFiLlama, growthepie, L2BEAT y Blockscout no requieren key.
# GitHub funciona sin token (60 req/h, suficiente con el cache de 12 h del
# módulo de infraestructura). Con token sube a 5.000/h y evita que una tanda
# de recargas en desarrollo deje las series de commits en N/A.
GITHUB_TOKEN=

# --- Opcionales (Fase 2, de pago) ---
GLASSNODE_API_KEY=
NANSEN_API_KEY=

# --- Control de acceso (deploy) ---
# Si APP_PASSWORD tiene valor, toda la app queda detrás de un password gate.
# Dejalo vacío para desarrollo local sin login.
APP_PASSWORD=
